rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Players collection - authenticated users can write their own profile
    match /players/{playerId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == playerId;
      allow delete: if request.auth != null && request.auth.uid == playerId;
    }
    
    // Lobbies - Cloud Functions handle creation, but clients can read and update
    match /lobbies/{lobbyCode} {
      allow read: if request.auth != null;
      // Allow Cloud Functions to create (they bypass rules)
      // Allow client-side updates for ready status, colors, etc.
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.hostId;
    }
    
    // Games - Cloud Functions handle writes, clients can read
    match /games/{gameId} {
      allow read: if request.auth != null;
      // Allow creation from Cloud Functions (they bypass rules anyway)
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      
      // Actions subcollection
      match /actions/{actionId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
      }
    }
  }
}
